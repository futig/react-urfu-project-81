{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "checkJs": true,
    "outDir": "./dist",
    "declaration": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "coverage", "local"]
}
